<div id="wrapper">
    <div class="account-dashboard management-container">

        <% if (title) { %>
            <h1><%= title %></h1>
        <% } else {
            res.redirect('/')
        } %>

        <%- messages() %>

        <h2>
            Welcome <%= locals.accountData.account_firstname %>
            <% if (locals.accountData.account_type === 'Client') { %>
                <span style="display: none;">Client</span>
            <% } else { %>
                (<%= locals.accountData.account_type %>)
            <% } %>
        </h2>

        <div class="account-details">
            <h3>Account Information</h3>
            <table class="detail-list">
                <tbody>
                    <tr>
                        <th>Full Name:</th>
                        <td><%= locals.accountData.account_firstname %> <%= locals.accountData.account_lastname %></td>
                    </tr>
                    <tr>
                        <th>Email:</th>
                        <td><%= locals.accountData.account_email %></td>
                    </tr>
                    <tr>
                        <th>Account Type:</th>
                        <td><%= locals.accountData.account_type %></td>
                    </tr>
                </tbody>
            </table>
            
            <p class="update-link">
                <a href="/account/update" class="dashboard-link form-submit-btn" title="Click to update name and email">Update Account Information</a>
            </p>

            <% if (locals.accountData.account_type === 'Admin' || locals.accountData.account_type === 'Employee') { %>
                <section class="management-section">
                    <h3>Inventory Management</h3>
                    <p class="management-actions">
                        <a href="/inv/" class="dashboard-link form-submit-btn" title="Click to access inventory management tools">Access Inventory Management</a>
                    </p>
                </section>
            <% } %>
            
            <section class="review-management-section">
                <h3>My Vehicle Reviews</h3>
                <p>Manage your submitted reviews below:</p>
                <%- reviewsTable %>
            </section>
            
        </div>
    </div>
</div>