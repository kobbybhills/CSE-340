<div class="inventory-form-container">

  <% if (title) { %>
    <h1 class="inventory-form-title"><%= title %></h1>
  <% } else { %>
    <%
      // If no title is provided, redirect to home
      res.redirect('/');
    %>
  <% } %>

  <%# 1. Display flash messages (SUCCESS or FAILURE) %>
  <%- messages() %>

  <%# 2. Display specific validation errors %>
  <% if (errors) { %>
    <ul class="notice">
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form class="inventory-form" action="/inv/add-inventory" method="post">

    <p class="notice">* All fields are required</p>

    <!-- Classification -->
    <div class="form-section">
      <div class="form-group">
        <label class="form-label" for="classificationList">Classification:</label>
        <div class="form-select-wrapper">
          <%- classificationList %>
        </div>
      </div>
    </div>

    <!-- Make & Model -->
    <div class="form-section">
      <div class="form-group">
        <label class="form-label" for="inv_make">Make:</label>
        <input 
          class="form-input" 
          type="text" 
          name="inv_make" 
          id="inv_make"
          required
          minlength="3"
          placeholder="Must be at least 3 characters"
          value="<%= inv_make %>"
        >
      </div>

      <div class="form-group">
        <label class="form-label" for="inv_model">Model:</label>
        <input 
          class="form-input" 
          type="text" 
          name="inv_model" 
          id="inv_model"
          required
          minlength="3"
          placeholder="Must be at least 3 characters"
          value="<%= inv_model %>"
        >
      </div>
    </div>

    <!-- Year, Price, Miles -->
    <div class="form-section form-row">
      <div class="form-group">
        <label class="form-label" for="inv_year">Year:</label>
        <input 
          class="form-input" 
          type="number" 
          name="inv_year" 
          id="inv_year"
          required
          min="1900"
          max="<%= new Date().getFullYear() + 1 %>"
          value="<%= inv_year %>"
        >
      </div>

      <div class="form-group">
        <label class="form-label" for="inv_price">Price ($):</label>
        <input 
          class="form-input" 
          type="number" 
          step="0.01" 
          name="inv_price" 
          id="inv_price"
          required
          min="0"
          value="<%= inv_price %>"
        >
      </div>

      <div class="form-group">
        <label class="form-label" for="inv_miles">Miles:</label>
        <input 
          class="form-input" 
          type="number" 
          name="inv_miles" 
          id="inv_miles"
          required
          min="0"
          value="<%= inv_miles %>"
        >
      </div>
    </div>

    <!-- Description -->
    <div class="form-section">
      <div class="form-group">
        <label class="form-label" for="inv_description">Description:</label>
        <textarea 
          class="form-textarea" 
          name="inv_description" 
          id="inv_description"
          required
          rows="3"
        ><%= inv_description %></textarea>
      </div>
    </div>

    <!-- Image & Thumbnail -->
    <div class="form-section form-row">
      <div class="form-group">
        <label class="form-label" for="inv_image">Image Path:</label>
        <input 
          class="form-input"
          type="text"
          name="inv_image"
          id="inv_image"
          required
          maxlength="255"
          placeholder="/images/vehicles/image.jpg"
          value="<%= inv_image %>"
        >
      </div>

      <div class="form-group">
        <label class="form-label" for="inv_thumbnail">Thumbnail Path:</label>
        <input 
          class="form-input"
          type="text"
          name="inv_thumbnail"
          id="inv_thumbnail"
          required
          maxlength="255"
          placeholder="/images/vehicles/image-tn.jpg"
          value="<%= inv_thumbnail %>"
        >
      </div>
    </div>

    <!-- Color -->
    <div class="form-section">
      <div class="form-group">
        <label class="form-label" for="inv_color">Color:</label>
        <input 
          class="form-input"
          type="text"
          name="inv_color"
          id="inv_color"
          required
          value="<%= inv_color %>"
        >
      </div>
    </div>

    <!-- Submit -->
    <div class="form-actions">
      <button class="form-submit-btn" type="submit">Add Inventory</button>
    </div>

  </form>

</div>
