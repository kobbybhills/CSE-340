<div class="inventory-form-container">
<% if (title) { %>
<h1 class="inventory-form-title"><%= title %></h1>
<% } else {
res.redirect('/')
} %>

<%# Use the standard messages() function for flash messages %>
<%- messages() %>

<%# Display validation errors %>
<%- locals.errors %>

<form class="inventory-form" action="/inv/add-inventory" method="post">
    <div class="form-section">
        <div class="form-group">
            <label class="form-label" for="classificationList">Classification:</label>
            <div class="form-select-wrapper">
                <%# classificationList is generated by the utility.buildClassificationList function %>
                <%- classificationList %>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="form-group">
            <label class="form-label" for="inv_make">Make:</label>
            <%# REQUIRED FIX: Use locals.inv_make to retain data after validation failure %>
            <input class="form-input" type="text" name="inv_make" id="inv_make" required value="<%= locals.inv_make %>">
        </div>

        <div class="form-group">
            <label class="form-label" for="inv_model">Model:</label>
            <%# REQUIRED FIX: Use locals.inv_model to retain data after validation failure %>
            <input class="form-input" type="text" name="inv_model" id="inv_model" required value="<%= locals.inv_model %>">
        </div>
    </div>

    <div class="form-section form-row">
        <div class="form-group">
            <label class="form-label" for="inv_year">Year:</label>
            <%# REQUIRED FIX: Use locals.inv_year and set current year max %>
            <input class="form-input" type="number" name="inv_year" id="inv_year" required 
                min="1900" max="<%= new Date().getFullYear() + 1 %>" 
                value="<%= locals.inv_year %>">
        </div>

        <div class="form-group">
            <label class="form-label" for="inv_price">Price ($):</label>
            <%# REQUIRED FIX: Use locals.inv_price %>
            <input class="form-input" type="number" step="0.01" name="inv_price" id="inv_price" required value="<%= locals.inv_price %>">
        </div>

        <div class="form-group">
            <label class="form-label" for="inv_miles">Miles:</label>
            <%# REQUIRED FIX: Use locals.inv_miles %>
            <input class="form-input" type="number" name="inv_miles" id="inv_miles" required value="<%= locals.inv_miles %>">
        </div>
    </div>

    <div class="form-section">
        <div class="form-group">
            <label class="form-label" for="inv_description">Description:</label>
            <%# REQUIRED FIX: Use locals.inv_description %>
            <textarea class="form-textarea" name="inv_description" id="inv_description" required><%= locals.inv_description %></textarea>
        </div>
    </div>

    <div class="form-section form-row">
        <div class="form-group">
            <label class="form-label" for="inv_image">Image Path:</label>
            <%# REQUIRED FIX: Use locals.inv_image and set a default placeholder %>
            <input class="form-input" type="text" name="inv_image" id="inv_image" 
                value="<%= locals.inv_image || '/images/vehicles/no-image.png' %>">
        </div>

        <div class="form-group">
            <label class="form-label" for="inv_thumbnail">Thumbnail Path:</label>
            <%# REQUIRED FIX: Use locals.inv_thumbnail and set a default placeholder %>
            <input class="form-input" type="text" name="inv_thumbnail" id="inv_thumbnail" 
                value="<%= locals.inv_thumbnail || '/images/vehicles/no-image-tn.png' %>">
        </div>
    </div>

    <div class="form-section">
        <div class="form-group">
            <label class="form-label" for="inv_color">Color:</label>
            <%# REQUIRED FIX: Use locals.inv_color %>
            <input class="form-input" type="text" name="inv_color" id="inv_color" required value="<%= locals.inv_color %>">
        </div>
    </div>

    <div class="form-actions">
        <button class="form-submit-btn" type="submit">Add Inventory</button>
    </div>
</form>


</div>